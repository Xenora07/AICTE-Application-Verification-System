# ==============================================================================
# SIH26261 — AICTE Application Verification System
# Environment Variable Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to `.env` in the repository root and customize values.
# NEVER commit the actual `.env` file containing production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY & PRIVACY GATEWAY (PERSON 3)
# ------------------------------------------------------------------------------
# [REQUIRED] Cryptographic salt used for scoped, keyed HMAC-SHA256 tokenization.
# Must be at least 16 characters long. Generate using: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Do NOT use the default placeholder below in production deployments!
AICTE_PRIVACY_SALT=replace_with_a_secure_random_salt_at_least_16_characters_long
TOKENIZATION_SECRET=replace_with_a_secure_random_salt_at_least_16_characters_long

# ------------------------------------------------------------------------------
# 2. FASTAPI & APPLICATION SERVER (PERSON 4)
# ------------------------------------------------------------------------------
# [OPTIONAL] Network interface and port for Uvicorn server (defaults: 0.0.0.0, 8000)
HOST=0.0.0.0
PORT=8000

# [OPTIONAL] Runtime environment: development | staging | production (default: development)
ENVIRONMENT=development

# [OPTIONAL] CORS allowed origins as JSON array (default: localhost frontend dev servers)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# [OPTIONAL] Temporary directory for uploaded PDF streams before validation (default: ./tmp/uploads)
UPLOAD_TEMP_DIR=./tmp/uploads

# ------------------------------------------------------------------------------
# 3. EXTRACTION & OCR ENGINE CONFIGURATION (PERSON 1)
# ------------------------------------------------------------------------------
# [OPTIONAL] Enable GPU acceleration for EasyOCR (default: false)
OCR_GPU_ENABLED=false

# [OPTIONAL] Comma-separated languages for EasyOCR (default: en)
OCR_LANGUAGES=en

# [OPTIONAL] EasyOCR rendering resolution in DPI (default: 150)
OCR_DPI=150

# ------------------------------------------------------------------------------
# 4. LOGGING & AUDIT CONFIGURATION
# ------------------------------------------------------------------------------
# [OPTIONAL] Application log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO
