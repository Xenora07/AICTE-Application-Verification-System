# SIH26261 - AICTE Application Verification System Configuration

# Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
DEBUG=True

# CORS Settings (Comma-separated origins for Frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# File Upload Settings
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB
ALLOWED_EXTENSIONS=.pdf
UPLOAD_TEMP_DIR=temp_uploads

# Security & Verification
ENABLE_PRIVACY_MASKING=True
OCR_ACCEPTANCE_THRESHOLD=0.65
